  --glass-blur: 16px;

  --shadow-sm: 0 1px 2px 0 rgba(15, 23, 42, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.05), 0 2px 4px -2px rgba(15, 23, 42, 0.05);
  --shadow-lg: 0 10px 15px -3px rgba(15, 23, 42, 0.05), 0 4px 6px -4px rgba(15, 23, 42, 0.04);
  --shadow-xl: 0 20px 25px -5px rgba(15, 23, 42, 0.06), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
  
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-full: 9999px;
  
  --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Theme: Dark override */
[data-theme="dark"] {
  --bg-color-h: 224;
  --bg-color-s: 71%;
  --bg-color-l: 4%;
  --bg: hsl(var(--bg-color-h), var(--bg-color-s), var(--bg-color-l));
  --bg-alt: hsl(224, 71%, 6%);
  --bg-surface: hsl(224, 71%, 8%);
  --bg-surface-alt: hsl(224, 71%, 11%);
  
  --border: hsl(224, 30%, 16%);
  --border-focus: hsl(217, 91%, 60%);
  
  --text-primary: hsl(210, 40%, 98%);
  --text-secondary: hsl(215, 20%, 75%);
  --text-tertiary: hsl(215, 15%, 52%);
  
  --primary: hsl(217, 91%, 56%);
  --primary-light: hsl(217, 91%, 12%);
  --primary-dark: hsl(217, 91%, 75%);
  
  --success: hsl(142, 68%, 45%);
  --success-light: hsl(142, 68%, 10%);
  --warning: hsl(38, 92%, 52%);
  --warning-light: hsl(38, 92%, 10%);
  --danger: hsl(0, 84%, 60%);
  --danger-light: hsl(0, 84%, 12%);
  
  --glass-bg: rgba(10, 15, 30, 0.8);
  --glass-border: rgba(30, 41, 59, 0.8);
  
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.2);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.35), 0 4px 6px -4px rgba(0, 0, 0, 0.25);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.45), 0 8px 10px -6px rgba(0, 0, 0, 0.35);
}

/* RESET & LAYOUT */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  height: -webkit-fill-available;
}

body {
  font-family: var(--font-body);
  color: var(--text-primary);
  background-color: var(--bg);
  font-size: 15px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  transition: background-color var(--transition-normal), color var(--transition-normal);
}

a {
  text-decoration: none;
  color: inherit;
}

button, input, select, textarea {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
  outline: none;
}

button {
  cursor: pointer;
  background: none;
  border: none;
}

h1, h2, h3, h4 {
  font-family: var(--font-heading);
  font-weight: 700;
  line-height: 1.25;
  color: var(--text-primary);
}

h1 { font-size: 2.2rem; }
h2 { font-size: 1.75rem; }
h3 { font-size: 1.3rem; }

/* UTILITY CLASSES */
.text-center { text-align: center; }
.text-success { color: hsl(var(--success)) !important; }
.text-danger { color: hsl(var(--danger)) !important; }
.text-warning { color: hsl(var(--warning)) !important; }
.rounded-lg { border-radius: var(--radius-lg); }
.border { border: 1px solid var(--border); }
.bg-surface-alt { background-color: var(--bg-surface-alt); }
.flex-center-y { display: flex; align-items: center; }

/* NAV BAR STYLINGS */
.glass-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border-bottom: 1px solid var(--glass-border);
  box-shadow: var(--shadow-sm);
  transition: background-color var(--transition-normal), border-color var(--transition-normal);
}

.nav-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 14px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.logo {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-primary);
}

.logo-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  background-color: var(--primary);
  color: #fff;
}

.logo-icon i, .logo-icon svg {
  width: 18px;
  height: 18px;
}

.brand-highlight {
  color: var(--primary);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
}

.nav-btn {
  padding: 8px 14px;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.nav-btn:hover, .nav-btn.active {
  color: var(--primary);
  background-color: var(--primary-light);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.icon-btn-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  border: 1px solid var(--border);
  background-color: var(--bg-surface);
  transition: all var(--transition-fast);
}

.icon-btn-toggle:hover {
  background-color: var(--bg-alt);
  color: var(--text-primary);
}

.icon-btn-toggle i, .icon-btn-toggle svg {
  width: 20px;
  height: 20px;
}

.nav-cta {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  background-color: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 0.9rem;
  font-weight: 600;
  transition: all var(--transition-fast);
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);
}

.nav-cta:hover {
  background-color: var(--primary-dark);
  box-shadow: 0 6px 14px rgba(37, 99, 235, 0.3);
}

.nav-cta i, .nav-cta svg {
  width: 16px;
  height: 16px;
}

.mobile-toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  color: var(--text-primary);
  border: 1px solid var(--border);
}

/* MOBILE DROPDOWN NAVIGATION */
.mobile-nav-overlay {
  display: none;
  position: fixed;
  top: 70px;
  left: 0;
  width: 100%;
  background-color: var(--bg-surface);
  border-bottom: 1px solid var(--border);
  z-index: 99;
  box-shadow: var(--shadow-lg);
  padding: 16px 24px;
}

.mobile-nav-overlay.active {
  display: block;
}

.mobile-menu-links {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.mobile-nav-btn {
  text-align: left;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  font-weight: 500;
  color: var(--text-secondary);
}

.mobile-nav-btn.active, .mobile-nav-btn:hover {
  background-color: var(--primary-light);
  color: var(--primary);
}

.mobile-nav-cta {
  text-align: center;
  padding: 12px;
  background-color: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  font-weight: 600;
  margin-top: 12px;
}

/* MAIN CONTAINER */
.main-container {
  flex: 1;
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
  padding: 24px;
}

.page {
  display: none;
}

.page.active {
  display: block;
  animation: fadeIn var(--transition-normal) forwards;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

/* HERO SECTION */
.hero-section {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-xl);
  padding: 80px 48px;
  margin-bottom: 32px;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--bg-alt) 100%);
  border: 1px solid var(--border);
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.hero-bg-shapes .shape {
  position: absolute;
  border-radius: var(--radius-full);
  filter: blur(80px);
  z-index: 0;
  opacity: 0.6;
}

.hero-bg-shapes .shape-1 {
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, var(--primary) 0%, rgba(255, 255, 255, 0) 70%);
  top: -80px;
  left: -80px;
}

.hero-bg-shapes .shape-2 {
  width: 350px;
  height: 350px;
  background: radial-gradient(circle, hsl(142, 72%, 60%) 0%, rgba(255, 255, 255, 0) 70%);
  bottom: -100px;
  right: -100px;
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 720px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 24px;
  box-shadow: var(--shadow-sm);
}

.hero-badge i, .hero-badge svg {
  width: 14px;
  height: 14px;
}

.hero-content h1 {
  font-size: 3.2rem;
  font-weight: 800;
  margin-bottom: 18px;
  letter-spacing: -0.02em;
}

.gradient-text {
  background: linear-gradient(135deg, var(--primary) 30%, hsl(220, 90%, 65%) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-content p {
  color: var(--text-secondary);
  font-size: 1.15rem;
  margin-bottom: 32px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.hero-actions {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}

.btn-primary {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background-color: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
  transition: all var(--transition-fast);
}

.btn-primary:hover {
  background-color: var(--primary-dark);
  transform: translateY(-1px);
}

.btn-primary i, .btn-primary svg {
  width: 18px;
  height: 18px;
}

.btn-secondary {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background-color: var(--bg-surface);
  color: var(--text-primary);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.btn-secondary:hover {
  background-color: var(--bg-alt);
  border-color: var(--text-tertiary);
  transform: translateY(-1px);
}

.btn-secondary i, .btn-secondary svg {
  width: 16px;
  height: 16px;
  transition: transform var(--transition-fast);
}

.btn-secondary:hover i, .btn-secondary:hover svg {
  transform: translateX(4px);
}

/* STATS GRID */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 48px;
}

.stat-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.stat-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background-color: var(--bg-alt);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon i, .stat-icon svg {
  width: 24px;
  height: 24px;
}

.stat-icon.highlight {
  background-color: var(--primary-light);
  color: var(--primary);
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-number {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.1;
}

.stat-desc {
  font-size: 0.8rem;
  color: var(--text-secondary);
  font-weight: 500;
  margin-top: 2px;
}

/* SECTION CONTAINER GENERAL */
.section-container {
  padding: 48px 0;
  margin-bottom: 24px;
}

.section-container.border {
  padding: 40px;
  margin-bottom: 48px;
}

.section-header {
  margin-bottom: 36px;
}

.section-header.text-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-badge {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--primary);
  margin-bottom: 8px;
}

.section-header h2 {
  font-size: 2rem;
  font-weight: 800;
  letter-spacing: -0.01em;
}

.section-subtitle {
  color: var(--text-secondary);
  font-size: 1.05rem;
  margin-top: 6px;
  max-width: 600px;
}

/* FEATURES GRID */
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 20px;
}

.feature-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-normal);
}

.feature-card:hover {
  border-color: var(--primary);
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.feat-icon {
  width: 50px;
  height: 50px;
  border-radius: var(--radius-md);
  background-color: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.feat-icon i, .feat-icon svg {
  width: 24px;
  height: 24px;
}

.feature-card h3 {
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 8px;
}

.feature-card p {
  color: var(--text-secondary);
  font-size: 0.95rem;
  line-height: 1.5;
  margin-bottom: 24px;
  flex: 1;
}

.feat-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--border);
  padding-top: 16px;
  margin-top: auto;
}

.feat-tag {
  font-size: 0.75rem;
  font-weight: 600;
  background-color: var(--bg-alt);
  color: var(--text-secondary);
  padding: 4px 10px;
  border-radius: var(--radius-full);
}

.feat-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--primary);
  transition: gap var(--transition-fast);
}

.feature-card:hover .feat-link {
  gap: 8px;
}

.feat-link i, .feat-link svg {
  width: 14px;
  height: 14px;
}

/* ALERT BOARD / UPDATES */
.updates-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}

.update-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: var(--shadow-sm);
  transition: border-color var(--transition-fast);
}

.update-card:hover {
  border-color: var(--text-tertiary);
}

.update-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
}

.update-date {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  gap: 4px;
}

.update-date i, .update-date svg {
  width: 12px;
  height: 12px;
}

.category-tag {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: var(--radius-full);
}

.category-tag.tag-gst { background-color: var(--success-light); color: var(--success); }
.category-tag.tag-it { background-color: var(--primary-light); color: var(--primary); }
.category-tag.tag-mca { background-color: var(--warning-light); color: var(--warning); }
.category-tag.tag-sebi { background-color: var(--danger-light); color: var(--danger); }

.update-card h3 {
  font-size: 0.95rem;
  font-weight: 600;
  line-height: 1.45;
  color: var(--text-primary);
  flex: 1;
}

/* COMPLIANCE CALENDAR TAB */
.calendar-panel {
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-md);
  margin-top: 12px;
}

.cal-header {
  margin-bottom: 24px;
}

.cal-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 20px;
}

.month-selector {
  display: flex;
  align-items: center;
  gap: 12px;
}

.control-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  background-color: var(--bg-surface);
  color: var(--text-primary);
  transition: all var(--transition-fast);
}

.control-btn:hover {
  background-color: var(--bg-alt);
  border-color: var(--text-tertiary);
}

.control-btn i, .control-btn svg {
  width: 16px;
  height: 16px;
}

.current-month-lbl {
  font-size: 1.15rem;
  font-weight: 700;
  min-width: 140px;
  text-align: center;
}

.filter-pills-container {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.filter-pill {
  padding: 6px 14px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius-full);
  background-color: var(--bg-surface);
  transition: all var(--transition-fast);
}

.filter-pill:hover {
  background-color: var(--bg-alt);
  color: var(--text-primary);
}

.filter-pill.active {
  background-color: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

/* DATA TABLE STYLINGS */
.table-responsive {
  width: 100%;
  overflow-x: auto;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.9rem;
}

.data-table th {
  padding: 14px 16px;
  font-weight: 600;
  font-family: var(--font-heading);
  color: var(--text-secondary);
  background-color: var(--bg-surface-alt);
  border-bottom: 2px solid var(--border);
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 0.05em;
}

.data-table td {
  padding: 16px;
  border-bottom: 1px solid var(--border);
  color: var(--text-primary);
  vertical-align: middle;
}

.data-table tbody tr {
  transition: background-color var(--transition-fast);
}

.data-table tbody tr:hover td {
  background-color: var(--bg-surface-alt);
}

/* STATUS BADGES */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  font-size: 0.75rem;
  font-weight: 700;
  border-radius: var(--radius-full);
}

.status-badge.urgent { background-color: var(--danger-light); color: var(--danger); }
.status-badge.soon { background-color: var(--warning-light); color: var(--warning); }
.status-badge.safe { background-color: var(--success-light); color: var(--success); }

/* CALCULATORS TABS */
.calculator-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 24px;
  flex-wrap: wrap;
  border-bottom: 1px solid var(--border);
  padding-bottom: 12px;
}

.calc-tab-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-secondary);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.calc-tab-btn i, .calc-tab-btn svg {
  width: 16px;
  height: 16px;
}

.calc-tab-btn:hover {
  background-color: var(--bg-alt);
  color: var(--text-primary);
}

.calc-tab-btn.active {
  background-color: var(--primary);
  color: #fff;
}

/* CALCULATOR PANES Layout */
.calculator-view {
  display: none;
}

.calculator-view.active {
  display: block;
  animation: fadeIn var(--transition-normal);
}

.calc-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 28px;
  align-items: start;
}

.calc-inputs-pane {
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px;
  box-shadow: var(--shadow-sm);
}

.calc-inputs-pane h3, .calc-results-pane h3 {
  font-size: 1.15rem;
  font-weight: 700;
  margin-bottom: 20px;
  border-left: 3px solid var(--primary);
  padding-left: 10px;
}

.input-group {
  margin-bottom: 18px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.input-group label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input-prefix {
  position: absolute;
  left: 14px;
  font-weight: 600;
  color: var(--text-tertiary);
  font-size: 1rem;
}

.input-wrapper input {
  padding-left: 28px !important;
}

.input-group input, .input-group select, .input-group textarea {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background-color: var(--bg-surface);
  color: var(--text-primary);
  font-size: 0.95rem;
  transition: all var(--transition-fast);
}

.input-group input:focus, .input-group select:focus, .input-group textarea:focus {
  border-color: var(--border-focus);
  box-shadow: 0 0 0 3px var(--primary-light);
}

.input-group-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.input-hint {
  font-size: 0.75rem;
  color: var(--text-tertiary);
}

.deductions-toggle-area {
  margin-top: 14px;
  padding-top: 18px;
  border-top: 1px dashed var(--border);
  animation: slideDown var(--transition-normal);
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* RESULTS PANE STYLINGS */
.calc-results-pane {
  background-color: var(--primary-light);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px;
  box-shadow: var(--shadow-sm);
  color: var(--text-primary);
}

/* Visual Breakdown Bar */
.visual-breakdown-bar {
  margin-bottom: 24px;
  background-color: var(--bg-surface);
  border-radius: var(--radius-md);
  padding: 16px;
  border: 1px solid var(--border);
}

.breakdown-title {
  display: block;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-secondary);
  margin-bottom: 10px;
  letter-spacing: 0.02em;
}

.bar-progress-container {
  display: flex;
  height: 10px;
  background-color: var(--bg-alt);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-bottom: 12px;
}

.bar-slice {
  height: 100%;
  transition: width var(--transition-slow) ease;
}

.slice-deductions { background-color: hsl(142, 68%, 45%); }
.slice-taxable { background-color: var(--primary); }
.slice-liability { background-color: var(--danger); }

.bar-legend {
  display: flex;
  gap: 12px;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.bar-legend span {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.bar-legend .dot {
  width: 8px;
  height: 8px;
  border-radius: var(--radius-full);
}

.bar-legend .dot.ded { background-color: hsl(142, 68%, 45%); }
.bar-legend .dot.taxable { background-color: var(--primary); }
.bar-legend .dot.liability { background-color: var(--danger); }

/* Results elements */
.results-rows {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.res-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  font-size: 0.9rem;
}

.res-item.border-top {
  border-top: 1px solid var(--border);
  padding-top: 14px;
  margin-top: 6px;
}

.res-lbl {
  color: var(--text-secondary);
  font-weight: 500;
}

.res-val {
  font-weight: 600;
  color: var(--text-primary);
}

.res-item.total-row {
  border-top: 2px solid var(--border);
  border-bottom: 2px solid var(--border);
  padding: 14px 0;
  margin-top: 6px;
  margin-bottom: 6px;
}

.res-item.total-row .res-lbl {
  font-weight: 700;
  color: var(--text-primary);
  font-size: 1.05rem;
}

.highlight-value {
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--primary);
}

.calc-info-note {
  margin-top: 20px;
  padding: 14px;
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  display: flex;
  gap: 10px;
  font-size: 0.75rem;
  line-height: 1.5;
  color: var(--text-secondary);
}

.calc-info-note i, .calc-info-note svg {
  width: 16px;
  height: 16px;
  color: var(--primary);
  flex-shrink: 0;
}

.calc-info-note span {
  flex: 1;
}

/* Timeline schedule for Advance Tax */
.installments-timeline {
  margin-top: 20px;
  border-top: 1px solid var(--border);
  padding-top: 16px;
}

.installments-timeline h4 {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12px;
}

.timeline-step {
  display: flex;
  justify-content: space-between;
  padding: 8px 12px;
  border-left: 2px solid var(--primary);
  background-color: var(--bg-surface);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  margin-bottom: 6px;
  font-size: 0.8rem;
}

.step-date {
  font-weight: 600;
  color: var(--text-secondary);
}

.step-amt {
  font-weight: 700;
  color: var(--text-primary);
}

/* DUE DATE TRACKER TAB */
.tracker-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 20px;
  margin-top: 12px;
}

.tracker-card {
  position: relative;
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-normal);
  overflow: hidden;
}

.tracker-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
}

/* Urgency styles */
.tracker-card.urgent { border-top: 4px solid var(--danger); }
.tracker-card.soon { border-top: 4px solid var(--warning); }
.tracker-card.safe { border-top: 4px solid var(--success); }

.t-days {
  font-size: 1.8rem;
  font-weight: 800;
  line-height: 1;
}

.t-days.urgent { color: var(--danger); }
.t-days.soon { color: var(--warning); }
.t-days.safe { color: var(--success); }

.t-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
}

.t-date {
  font-size: 0.8rem;
  color: var(--text-secondary);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 4px;
}

.t-form {
  align-self: flex-start;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  background-color: var(--bg-alt);
  color: var(--text-secondary);
  padding: 3px 8px;
  border-radius: var(--radius-full);
  border: 1px solid var(--border);
}

/* DOCUMENT CHECKLIST TAB */
.checklist-wrap {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  margin-top: 12px;
}

.checklist-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
}

.checklist-card h3 {
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.ch-icon {
  font-size: 1.25rem;
}

.check-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid var(--bg-alt);
  cursor: pointer;
  user-select: none;
}

.check-item:last-of-type {
  border-bottom: none;
}

.check-box {
  width: 20px;
  height: 20px;
  border-radius: 4px;
  border: 2px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background-color: var(--bg-surface);
  transition: all var(--transition-fast);
}

.check-box i, .check-box svg {
  width: 12px;
  height: 12px;
  color: #fff;
  opacity: 0;
  transform: scale(0.6);
  transition: all var(--transition-fast);
}

.check-box.done {
  background-color: var(--primary);
  border-color: var(--primary);
}

.check-box.done i, .check-box.done svg {
  opacity: 1;
  transform: scale(1);
}

.check-label {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.4;
  transition: all var(--transition-fast);
}

.check-label.done {
  text-decoration: line-through;
  color: var(--text-tertiary);
}

.progress-bar-container {
  margin-top: auto;
  padding-top: 16px;
}

.progress-bar {
  height: 6px;
  background-color: var(--bg-alt);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-bottom: 6px;
}

.progress-fill {
  height: 100%;
  background-color: var(--primary);
  width: 0%;
  border-radius: var(--radius-full);
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.prog-txt {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-tertiary);
}

/* GST FINDER LAYOUT */
.finder-layout {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 12px;
}

.search-box-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  max-width: 480px;
  width: 100%;
}

.search-icon {
  position: absolute;
  left: 14px;
  width: 18px;
  height: 18px;
  color: var(--text-tertiary);
}

.search-box-wrapper input {
  width: 100%;
  padding: 12px 14px 12px 42px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background-color: var(--bg-surface);
  color: var(--text-primary);
  transition: all var(--transition-fast);
}

.search-box-wrapper input:focus {
  border-color: var(--border-focus);
  box-shadow: 0 0 0 3px var(--primary-light);
}

.search-clear-btn {
  position: absolute;
  right: 14px;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-clear-btn:hover {
  color: var(--text-primary);
}

.search-clear-btn i, .search-clear-btn svg {
  width: 16px;
  height: 16px;
}

.rate-pill {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  display: inline-block;
}

.rate-pill.r0 { background-color: var(--success-light); color: var(--success); }
.rate-pill.r5 { background-color: var(--primary-light); color: var(--primary); }
.rate-pill.r12 { background-color: var(--warning-light); color: var(--warning); }
.rate-pill.r18 { background-color: var(--danger-light); color: var(--danger); }
.rate-pill.r28 { background-color: hsl(0, 84%, 15%); color: hsl(0, 84%, 60%); }

/* UNION BUDGET DASHBOARD */
.budget-dashboard {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 12px;
}

.budget-panel-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}

.budget-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-sm);
}

.budget-card h3 {
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 12px;
}

.budget-card h3 i, .budget-card h3 svg {
  width: 18px;
  height: 18px;
  color: var(--primary);
}

.budget-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.b-list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
  padding: 4px 0;
  border-bottom: 1px solid var(--bg-alt);
}

.b-list-item:last-child {
  border-bottom: none;
}

.b-list-item span {
  color: var(--text-secondary);
}

.b-list-item strong {
  font-weight: 600;
  color: var(--text-primary);
}

.b-list-item .badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: var(--radius-sm);
}

.b-list-item .badge-success {
  background-color: var(--success-light);
  color: var(--success);
}

.budget-summary-panel {
  background-color: var(--primary-light);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
  display: flex;
  gap: 16px;
  align-items: flex-start;
  font-size: 0.85rem;
  line-height: 1.6;
}

.budget-summary-panel .panel-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: var(--radius-md);
  background-color: var(--primary);
  color: #fff;
  flex-shrink: 0;
}

.budget-summary-panel .panel-icon i, .budget-summary-panel .panel-icon svg {
  width: 18px;
  height: 18px;
}

.budget-summary-panel .panel-text {
  flex: 1;
}

/* CONTACT PAGE STYLINGS */
.contact-layout {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 36px;
  margin-top: 12px;
}

.contact-details-col {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 20px;
  border-radius: var(--radius-lg);
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}

.contact-item .c-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background-color: var(--primary-light);
  color: var(--primary);
  flex-shrink: 0;
}

.contact-item .c-icon i, .contact-item .c-icon svg {
  width: 20px;
  height: 20px;
}

.c-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.c-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-tertiary);
  letter-spacing: 0.05em;
}

.c-val {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-primary);
}

.highlight-whatsapp {
  border-color: hsl(142, 70%, 40%);
  background-color: var(--success-light);
}

.highlight-whatsapp .c-icon {
  background-color: var(--success);
  color: #fff;
}

.highlight-whatsapp .c-val {
  color: var(--success);
}

/* Form Styles */
.contact-form {
  background-color: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 32px;
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-group label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.form-group input, .form-group select, .form-group textarea {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background-color: var(--bg-surface);
  color: var(--text-primary);
  font-size: 0.9rem;
  transition: all var(--transition-fast);
}

.form-group textarea {
  resize: vertical;
  min-height: 110px;
}

.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
  border-color: var(--border-focus);
  box-shadow: 0 0 0 3px var(--primary-light);
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px;
  background-color: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  font-weight: 700;
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);
  transition: all var(--transition-fast);
  margin-top: 8px;
}

.submit-btn:hover {
  background-color: var(--primary-dark);
  box-shadow: 0 6px 14px rgba(37, 99, 235, 0.3);
}

.submit-btn i, .submit-btn svg {
  width: 16px;
  height: 16px;
}

/* FOOTER SECTION */
footer {
  background-color: var(--bg-alt);
  border-top: 1px solid var(--border);
  padding: 56px 24px 28px;
  margin-top: 60px;
  color: var(--text-secondary);
}

.footer-container {
  max-width: 1280px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr 1fr;
  gap: 40px;
}

.footer-brand {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.footer-brand p {
  font-size: 0.85rem;
  line-height: 1.5;
  max-width: 320px;
}

.footer-links-col {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-links-col h4 {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--text-primary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.footer-links-col button {
  text-align: left;
  font-size: 0.85rem;
  color: var(--text-secondary);
  transition: color var(--transition-fast);
}

.footer-links-col button:hover {
  color: var(--primary);
}

.footer-copy-col {
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-size: 0.8rem;
}

.disclaimer {
  font-size: 0.75rem;
  color: var(--text-tertiary);
  line-height: 1.4;
}

/* CUSTOM TOAST NOTIFICATION STYLES */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 1000;
  pointer-events: none;
}

.toast {
  pointer-events: auto;
  display: flex;
  align-items: center;
  gap: 12px;
  background-color: var(--bg-surface);
  color: var(--text-primary);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-xl);
  padding: 16px 20px;
  border-radius: var(--radius-lg);
  min-width: 320px;
  max-width: 420px;
  animation: toastIn var(--transition-normal) forwards, toastOut var(--transition-normal) 4.5s forwards;
  position: relative;
  overflow: hidden;
}

.toast::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
}

.toast.toast-success::before { background-color: hsl(var(--success)); }
.toast.toast-error::before { background-color: hsl(var(--danger)); }
.toast.toast-info::before { background-color: var(--primary); }

.toast-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
}

.toast-success .toast-icon { background-color: var(--success-light); color: var(--success); }
.toast-error .toast-icon { background-color: var(--danger-light); color: var(--danger); }
.toast-info .toast-icon { background-color: var(--primary-light); color: var(--primary); }

.toast-icon i, .toast-icon svg {
  width: 16px;
  height: 16px;
}

.toast-content {
  flex: 1;
}

.toast-title {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.9rem;
  line-height: 1.2;
}

.toast-message {
  font-size: 0.8rem;
  color: var(--text-secondary);
  margin-top: 2px;
}

.toast-close {
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.toast-close:hover {
  color: var(--text-primary);
}

.toast-close i, .toast-close svg {
  width: 14px;
  height: 14px;
}

@keyframes toastIn {
  from { opacity: 0; transform: translateY(24px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes toastOut {
  0%, 90% { opacity: 1; transform: translateY(0); }
