# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Postgres Database Configuration
POSTGRES_USER="your-database-user"
POSTGRES_PASSWORD="your-database-password"
POSTGRES_DATABASE="your-database-name"
POSTGRES_HOST="your-database-host"
POSTGRES_URL="your-database-connection-url"
POSTGRES_PRISMA_URL="your-database-prisma-connection-url"
POSTGRES_URL_NON_POOLING="your-database-non-pooling-connection-url"

# Google Sheets CMS Integration
NEXT_PUBLIC_GOOGLE_SHEET_CSV_URL="your-published-google-sheet-csv-url"

# Email OTP Service Configuration (Optional: for live SMTP delivery to user inboxes)
# If left blank, the portal automatically operates in local/demo mode with console and on-screen test hints.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Fin2ools Security <no-reply@fin2ools.online>"
